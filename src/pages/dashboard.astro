---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

// Count failure renders the page without the number (no page error).
let flashcardCount: number | null = null;
let dueCount: number | null = null;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  const [all, due] = await Promise.all([
    supabase.from("flashcards").select("*", { count: "exact", head: true }),
    supabase
      .from("flashcards")
      .select("*", { count: "exact", head: true })
      .lte("due", new Date().toISOString()),
  ]);
  if (!all.error) flashcardCount = all.count;
  if (!due.error) dueCount = due.count;
}
---

<Layout title="Panel">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1
        class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
      >
        Panel
      </h1>
      <p class="text-blue-100/80">
        Witaj, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      {
        flashcardCount !== null && (
          <p class="mt-4 text-blue-100/80">
            Zapisane fiszki:{" "}
            <span class="text-2xl font-semibold text-white">
              {flashcardCount}
            </span>
          </p>
        )
      }
      {
        dueCount !== null && (
          <p class="mt-2 text-blue-100/80">
            Do powtórki:{" "}
            <span class="text-2xl font-semibold text-white">{dueCount}</span>
          </p>
        )
      }
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        {
          flashcardCount !== 0 && (
            <a
              href="/review"
              class="inline-block rounded-lg bg-emerald-600 px-5 py-2.5 font-medium text-white transition-colors hover:bg-emerald-500"
            >
              Rozpocznij powtórki
            </a>
          )
        }
        {
          flashcardCount !== 0 && (
            <a
              href="/flashcards"
              class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2.5 font-medium text-white transition-colors hover:bg-white/20"
            >
              Moje fiszki
            </a>
          )
        }
        <a
          href="/generate"
          class="inline-block rounded-lg bg-purple-600 px-5 py-2.5 font-medium text-white transition-colors hover:bg-purple-500"
        >
          Generuj fiszki
        </a>
      </div>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Wyloguj się
        </button>
      </form>
    </div>
  </div>
</Layout>
