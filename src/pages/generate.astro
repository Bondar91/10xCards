---
import Layout from "@/layouts/Layout.astro";
import FlashcardGenerator from "@/components/generate/FlashcardGenerator";
---

<Layout title="Generuj fiszki">
  <div class="bg-cosmic flex min-h-screen justify-center p-4 py-10">
    <div class="w-full max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Generuj fiszki
        </h1>
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">← Panel</a>
      </div>
      <FlashcardGenerator client:load />
    </div>
  </div>
</Layout>
